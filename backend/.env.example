# =============================================================================
# BeatBox Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Environment ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --- Database ---
# For development, SQLite is used by default. For production, use PostgreSQL.
DATABASE_URL="file:./dev.db"
# PostgreSQL production example:
# DATABASE_URL="postgresql://user:password@localhost:5432/beatbox?schema=public"

# --- JWT Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8080,http://10.0.2.2:3000

# --- File Storage ---
# Local storage path for uploads (development). Use S3-compatible storage in production.
UPLOAD_DIR=./uploads
# For production S3-compatible storage:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=beatbox-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_PUBLIC_BASE_URL=https://cdn.beatbox.com

# --- File Upload Limits ---
MAX_AUDIO_FILE_SIZE_MB=100
MAX_IMAGE_FILE_SIZE_MB=10
ALLOWED_AUDIO_FORMATS=mp3,wav,m4a,aac,flac,ogg
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# --- Premium System ---
PREMIUM_FREE_USES=5

# --- Stripe Configuration ---
# IMPORTANT: These must be obtained from your Stripe Dashboard.
# NEVER put these in the Android app or commit them to Git.
# If Stripe is not configured, the subscription/payment features will be disabled.
# The rest of the application will continue to work.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Public key - safe to expose to client
STRIPE_PUBLISHABLE_KEY=

# --- Frontend URLs ---
# Used for Stripe Checkout success/cancel URLs
APP_URL=http://localhost:8080
WEBHOOK_SUCCESS_URL=http://localhost:8080/subscription/success
WEBHOOK_CANCEL_URL=http://localhost:8080/subscription/cancel

# --- Admin ---
# The first user created with this email will be assigned admin role
ADMIN_EMAIL=admin@beatbox.com

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
