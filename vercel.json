{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd backend && npm install && npx prisma generate && npx prisma db push && npx tsx prisma/seed.ts",
  "devCommand": "cd backend && npm run dev",
  "installCommand": "cd backend && npm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/uploads/(.*)",
      "dest": "/api/v1/uploads/$1"
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "/api"
    },
    {
      "src": "/health",
      "dest": "/api"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
