{
  "version": 2,
  "installCommand": "npm install && npx prisma generate --schema=backend/prisma/schema.prisma",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api"
    },
    {
      "src": "/health",
      "dest": "/api"
    }
  ]
}
